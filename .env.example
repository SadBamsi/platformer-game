# .env.example — корневой шаблон переменных окружения для docker compose.
#
# Как использовать:
#   1. cp .env.example .env
#   2. Впишите настоящий POSTGRES_PASSWORD (обязательно, дефолта нет).
#   3. ln -sf ../.env infra/.env   ← см. ВАЖНО ниже, без этого шага
#      docker compose из корневых скриптов (db:up/docker:up) значения
#      отсюда не увидит.
#   4. docker compose -f infra/docker-compose.yml up --build
#      (или просто: pnpm docker:up)
#
# .env в .gitignore, сюда реальные пароли/секреты НЕ коммитятся — только
# безопасные примеры для локальной разработки.
#
# ВАЖНО (см. подробности в infra/docker-compose.yml, шапка файла): Docker
# Compose по умолчанию ищет .env в директории Dockerfile'а/compose-файла
# (infra/), а не в корне репозитория, даже если сама команда запущена из
# корня. infra/.env — симлинк на этот файл (../.env), создаётся локально
# командой из шага 3, не коммитится (тот же паттерн .gitignore, что и
# .env).

# ============================================================================
# db (postgres:16-alpine) — сервис принадлежит database-engineer,
# infra/docker-compose.yml → service `db`. Переменные ниже перечислены
# database-engineer в шапке того файла, .env.example для них веду я
# (devops-engineer).
# ============================================================================

# Пользователь БД. По умолчанию (если не задано) — agentic_game.
POSTGRES_USER=agentic_game

# Пароль БД. ОБЯЗАТЕЛЕН — дефолта намеренно нет, `docker compose up`
# упадёт с понятной ошибкой, если переменная не задана. Значение ниже —
# пример для ЛОКАЛЬНОЙ разработки, не используйте его нигде за пределами
# машины разработчика.
POSTGRES_PASSWORD=password

# Имя базы данных. По умолчанию (если не задано) — agentic_game.
POSTGRES_DB=agentic_game

# Порт НА ХОСТЕ, пробрасываемый на 5432 в контейнере db. По умолчанию 5432.
# Сервис api ходит в db всегда по внутреннему докер-порту 5432 (см.
# infra/docker-compose.yml, service `api` → DATABASE_URL) — эта переменная
# влияет только на доступ к БД с хоста (например psql с ноутбука).
POSTGRES_PORT=5432

# ============================================================================
# api (@agentic-game/api, Fastify) — infra/docker-compose.yml → service
# `api`. Источник истины по переменным — apps/api/src/config/env.ts и
# apps/api/src/db/pool.ts (все читаются и валидируются там же).
# ============================================================================

# Порт НА ХОСТЕ, пробрасываемый на 4000 в контейнере api. По умолчанию
# 4000. Внутри docker-сети api всегда слушает 4000 — эта переменная влияет
# только на доступ с хоста.
API_PORT=4000

# development | test | production. Внутри Docker-образа api по умолчанию
# уже production (см. infra/Dockerfile.api), эта переменная позволяет
# переопределить его при необходимости (например для смоук-теста).
NODE_ENV=production

# Allowlist origin'ов для CORS на api (через запятую, без пробелов внутри
# каждого значения) — см. apps/api/src/config/env.ts::readGameOrigins.
# ОБЯЗАТЕЛЬНО должен совпадать с тем адресом, по которому БРАУЗЕР
# открывает game (см. GAME_PORT ниже), а не с внутренним docker-именем
# сервиса — иначе CORS будет блокировать все запросы из браузера.
GAME_ORIGIN=http://localhost:3000

# --- пул соединений с БД (все опциональны, см. apps/api/src/db/pool.ts) ---
# Максимум клиентов в pg.Pool. Дефолт самого pg — 10.
DB_POOL_MAX=10
# Простаивающий клиент закрывается через столько мс. Дефолт 30000.
DB_IDLE_TIMEOUT_MS=30000
# Таймаут установления соединения, мс. Дефолт 5000.
DB_CONNECTION_TIMEOUT_MS=5000
# Таймаут выполнения одного statement на стороне Postgres, мс. Дефолт 5000.
DB_STATEMENT_TIMEOUT_MS=5000
# Таймаут для клиента, зависшего "idle in transaction", мс. Дефолт 5000.
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=5000

# Примечание: DATABASE_URL для контейнера api НЕ задаётся здесь напрямую —
# infra/docker-compose.yml собирает его сам из POSTGRES_USER/PASSWORD/DB
# выше и внутреннего имени сервиса db, чтобы пароль не пришлось дублировать
# в двух местах (см. комментарий там же). Если вы запускаете apps/api ВНЕ
# Docker (pnpm dev:api / pnpm db:migrate на хосте) — DATABASE_URL нужно
# экспортировать отдельно, например:
#   export DATABASE_URL=postgres://agentic_game:agentic_game_dev_password@localhost:5432/agentic_game
# (localhost, а не db — на хосте нет docker DNS, обращаться нужно через
# порт, проброшенный POSTGRES_PORT).

# ============================================================================
# game (@agentic-game/game, Next.js) — infra/docker-compose.yml → service
# `game`. Источник истины — apps/game/.env.local.example и
# apps/game/src/lib/env.ts.
# ============================================================================

# Порт НА ХОСТЕ, пробрасываемый на 3000 в контейнере game. По умолчанию
# 3000.
GAME_PORT=3000

# ВНИМАНИЕ: это ПУБЛИЧНАЯ переменная Next.js (префикс NEXT_PUBLIC_) — она
# ВШИВАЕТСЯ в клиентский JS-бандл на этапе `next build` (build-time), а НЕ
# читается из окружения запущенного контейнера (runtime). Чтобы изменить
# значение, образ game нужно ПЕРЕСОБРАТЬ (`docker compose build game`),
# одним и тем же уже собранным образом для разных окружений с разным API
# URL пользоваться нельзя — см. infra/Dockerfile.game (build ARG) и
# apps/game/src/lib/env.ts.
# Значение — адрес api, ВИДИМЫЙ БРАУЗЕРУ (хост + API_PORT), а не
# внутреннее docker-имя сервиса api.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
